# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Only needed for --adjudicator agent. Everything else runs without a key.

GROQ_API_KEY=gsk_your_key_here
# Optional. Omit and the agent asks the provider what it serves and picks.
GROQ_MODEL=

# Alternatives, same OpenAI-compatible adapter:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
